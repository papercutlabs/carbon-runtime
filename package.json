{
  "name": "carbon-runtime",
  "version": "0.9.0",
  "description": "The part of Carbon that runs on a box: the store library, the adapters, the reply tool and the process a unit starts.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "carbon-runtime": "bin/carbon-runtime",
    "carbon-stream": "bin/carbon-stream",
    "carbon-whatsapp": "bin/carbon-whatsapp",
    "carbon-telegram": "bin/carbon-telegram",
    "carbon-import": "bin/carbon-import",
    "carbon-tool-server": "bin/carbon-tool-server",
    "carbon-records": "bin/carbon-records"
  },
  "scripts": {
    "test": "node tools/test-runner.ts",
    "typecheck": "tsc --noEmit && node tools/check-entrypoints.ts",
    "check": "node bin/carbon-stream check --adapter adapters/fixture --fixtures adapters/fixture/fixtures",
    "check:email": "node bin/carbon-stream check --adapter adapters/email --fixtures adapters/email/fixtures",
    "check:whatsapp": "node bin/carbon-stream check --adapter adapters/whatsapp --fixtures adapters/whatsapp/fixtures",
    "check:telegram": "node bin/carbon-stream check --adapter adapters/telegram --fixtures adapters/telegram/fixtures",
    "check:import": "node bin/carbon-stream check --adapter import/carbon-capture-whatsapp --fixtures import/fixtures",
    "check:ledger": "node bin/carbon-stream check --adapter import/carbon-ledger-sqlite --fixtures import/ledger-fixtures",
    "release": "node tools/release.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
