#!/usr/bin/env node
// carbon-runtime — the process a systemd unit starts, and the only one.
//
// On a box it is started with one argument, the agent directory, because install
// rendered everything else into that directory. Off a box every path is passed
// explicitly, because a local run has no install behind it and a default that
// guesses is how a test run writes into a live store.

import fs from 'node:fs';
import path from 'node:path';
import { fault, report, RuntimeFault, EXIT } from '../runtime/faults.mjs';
import { run, placesUnder, readDeclaration } from '../runtime/index.mjs';
import { REPLY_PORT } from '../runtime/reply-tool.mjs';
import { TEACH_PORT } from '../runtime/teach-tool.mjs';
import { registeredKinds } from '../runtime/registry.mjs';
import * as codex from '../harness/codex/index.mjs';

const HELP = `carbon-runtime — run one client agent: the harness, the adapters and the release loop

Usage:
  carbon-runtime run --agent-dir <dir>
  carbon-runtime run --declaration <file> --store <dir> --codex-home <dir> --checkout <dir>
                     --work <dir> [--binary <path>] [--harness-root <dir>]
                     [--reply-port <n>] [--teach-port <n>] [--items <file>]
                     [--passes <n>]

On a box there is one form: --agent-dir. Everything the runtime needs was
rendered into that directory by install, and it is read from there:

  <agent-dir>/current/carbon.agent.json   the declaration
  <agent-dir>/store                       the store, and the latch under it
  <agent-dir>/codex-home                  CODEX_HOME: config.toml and the rollouts
  <agent-dir>/current/repo                the checkout, read-only, the agent's own repository
  <agent-dir>/work                        the thread's working directory, and the unit's log
  <agent-dir>/harness/<version>/codex     the pinned harness binary

Off a box each of those is passed explicitly. Nothing is guessed and nothing has
a default that points at a real path.

  --agent-dir <dir>     the agent's directory on a box; the other paths follow from it
  --declaration <file>  the declaration to run from
  --store <dir>         the store this agent writes into
  --codex-home <dir>    CODEX_HOME for the harness child
  --checkout <dir>      the agent's checkout, read-only, named in every turn's input
  --work <dir>          the working directory a thread is opened on; the checkout's
                        AGENTS.md and .agents are linked into it, because the harness
                        reads those out of the working directory and out of nowhere else
  --binary <path>       the harness binary, when it is not under --harness-root
  --harness-root <dir>  where the pinned binaries are unpacked, one directory per version
  --reply-port <n>      the loopback port the reply tool listens on (default ${REPLY_PORT},
                        which is the number install renders into config.toml)
  --teach-port <n>      the loopback port the teaching tools listen on (default ${TEACH_PORT},
                        which is the number install renders into config.toml). They are
                        served only when the declaration's teaching block is enabled
  --items <file>        a JSON array of channel items, read again on every pass, for a
                        channel whose adapter takes its items from the caller
  --passes <n>          stop after this many passes, instead of running until the unit
                        stops it

How the agent authenticates is the declaration's, not a flag. With
provider.auth chatgpt, which is what a client agent runs on, this process passes
nothing: the harness reads its own auth file out of --codex-home and refreshes it
there, and that file is written once by a device login run as the agent user on
the box. With provider.auth api_key the runtime reads the file api_key_ref names
and passes it to the harness child alone.

What it does, in order: refuse if the store is latched; load an adapter for every
declared channel (${registeredKinds().join(', ')}); refuse any channel whose poll_interval_ms is
below its adapter's floor; take one lock per adapter, taking over a lock whose
holder is not alive; start the http tool servers that run as the agent user, with
an environment built from empty; wait for the ones that run under their own unit as
the tools user to answer on loopback; serve the reply tool on loopback; spawn the harness
as a direct child; then, on every pass, poll the channel, recover what the last
run owed, capture what is pending, release what policy allows and deliver what the
model replied.

Each channel is polled on its own poll_interval_ms and the process sleeps until
whichever channel is due first. An adapter that exports poll goes to the channel;
one that does not takes what --items hands it. A poll that fails is a named fault
in the log and a field on the channel, never the end of this process; past the
channel's poll_failures_before_hold the channel holds and does no work until a
poll works again, and doctor reports the hold from outside the box.

Every fault is one JSON line of {code, subject, problem, fix}. Exit codes:

  0   stopped cleanly, having run the passes asked for
  1   a refusal: nothing started
  ${EXIT.HARNESS_EXITED}  the harness child exited; the unit restarts the pair
  ${EXIT.LOCK_HELD}  another runtime is alive and holds an adapter's lock
  ${EXIT.LATCHED}  the terminal latch: a person decides, and carbon install clears it`;

const BOOLEAN_FLAGS = [];
const FLAGS = ['agent-dir', 'declaration', 'store', 'codex-home', 'checkout', 'work', 'binary',
  'harness-root', 'reply-port', 'teach-port', 'items', 'passes'];

function parse(argv) {
  const args = {};
  const faults = [];
  for (let i = 0; i < argv.length; i++) {
    const name = argv[i].startsWith('--') ? argv[i].slice(2) : null;
    if (name && BOOLEAN_FLAGS.includes(name)) {
      args[name] = true;
      continue;
    }
    if (name && FLAGS.includes(name)) {
      const value = argv[++i];
      if (value === undefined) {
        faults.push(fault('ARGUMENT_WITHOUT_VALUE', argv[i - 1], 'this argument was given with no value', 'give it a value'));
        continue;
      }
      args[name] = value;
      continue;
    }
    faults.push(fault('UNKNOWN_ARGUMENT', argv[i], 'not an argument of carbon-runtime run', 'run carbon-runtime --help'));
  }
  return { args, faults };
}

function places(args, faults) {
  if (args['agent-dir']) {
    for (const name of ['declaration', 'store', 'codex-home', 'checkout', 'work', 'harness-root']) {
      if (args[name]) {
        faults.push(fault('ARGUMENTS_CONFLICT', `--${name}`,
          '--agent-dir says where everything is, so a second path for the same thing is two answers to one question',
          'pass --agent-dir alone, or pass every path explicitly'));
      }
    }
    const under = placesUnder(path.resolve(args['agent-dir']));
    return {
      declarationPath: under.declaration,
      storeDir: under.store,
      codexHome: under.codexHome,
      checkout: under.checkout,
      work: under.work,
      harnessRoot: under.harnessRoot
    };
  }
  for (const name of ['declaration', 'store', 'codex-home', 'checkout', 'work']) {
    if (!args[name]) {
      faults.push(fault('MISSING_ARGUMENT', `--${name}`,
        'a run without --agent-dir names every path itself, and this one is missing',
        'pass --agent-dir <dir>, or pass --declaration, --store, --codex-home, --checkout and --work'));
    }
  }
  return {
    declarationPath: args.declaration ? path.resolve(args.declaration) : null,
    storeDir: args.store ? path.resolve(args.store) : null,
    codexHome: args['codex-home'] ? path.resolve(args['codex-home']) : null,
    checkout: args.checkout ? path.resolve(args.checkout) : null,
    work: args.work ? path.resolve(args.work) : null,
    harnessRoot: args['harness-root'] ? path.resolve(args['harness-root']) : null
  };
}

async function main(argv) {
  const rest = argv.slice(2);
  if (rest.length === 0 || rest[0] === '--help' || rest[0] === '-h') {
    console.log(HELP);
    return rest.length === 0 ? 1 : 0;
  }
  if (rest[0] !== 'run') {
    report([fault('UNKNOWN_SUBCOMMAND', rest[0], 'the only carbon-runtime subcommand is run', 'run carbon-runtime --help')]);
    return 1;
  }
  if (rest.includes('--help') || rest.includes('-h')) {
    console.log(HELP);
    return 0;
  }

  const { args, faults } = parse(rest.slice(1));
  const where = places(args, faults);
  if (faults.length > 0) {
    report(faults);
    return 1;
  }

  const declaration = readDeclaration(where.declarationPath);
  const itemsFile = args.items ? path.resolve(args.items) : null;
  const readItems = () => {
    if (!itemsFile || !fs.existsSync(itemsFile)) return [];
    return JSON.parse(fs.readFileSync(itemsFile, 'utf8'));
  };

  const log = (line) => process.stdout.write(JSON.stringify({ at: new Date().toISOString(), ...line }) + '\n');

  return run({
    declaration,
    declarationPath: where.declarationPath,
    storeDir: where.storeDir,
    codexHome: where.codexHome,
    checkout: where.checkout,
    work: where.work,
    harnessRoot: where.harnessRoot,
    binary: args.binary ? path.resolve(args.binary) : null,
    replyPort: args['reply-port'] ? Number(args['reply-port']) : REPLY_PORT,
    teachPort: args['teach-port'] ? Number(args['teach-port']) : TEACH_PORT,
    passes: args.passes ? Number(args.passes) : Infinity,
    harness: codex,
    items: readItems,
    log
  });
}

main(process.argv).then((code) => { process.exitCode = code; }).catch((error) => {
  if (error instanceof RuntimeFault) {
    report(error.faults);
    process.exitCode = error.exitCode;
    return;
  }
  if (error?.fault) {
    report(error.faults ?? [error.fault]);
    process.exitCode = EXIT.FAULT;
    return;
  }
  report([fault('RUNTIME_THREW', 'carbon-runtime', error?.message ?? String(error),
    'this is a fault the runtime does not name; the stack is on stderr')]);
  process.stderr.write(`${error?.stack ?? error}\n`);
  process.exitCode = EXIT.FAULT;
});
